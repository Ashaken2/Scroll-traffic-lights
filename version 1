const int red = 2;
const int yellow = 4;
const int green = 7;
int scroll = A0; //potentiometer

void setup() {
  
  pinMode(red, OUTPUT);
  pinMode(yellow, OUTPUT);
  pinMode(green, OUTPUT);
  pinMode(scroll, INPUT);
  Serial.begin(9600);
}

void loop() {
  
  int num = analogRead(scroll);
  Serial.println(num);

  if (num < 300) {
    digitalWrite(red, HIGH);
    digitalWrite(yellow, LOW);
    digitalWrite(green, LOW);

  }
  else if (num < 700) {
    digitalWrite(red, LOW);
    digitalWrite(yellow, HIGH);
    digitalWrite(green, LOW);
  }
  else {
    digitalWrite(red, LOW);
    digitalWrite(yellow, LOW);
    digitalWrite(green, HIGH);
  }

}
